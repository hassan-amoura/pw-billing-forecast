# Secrets — every credential lives in the environment, never in the repo.
# .env.example is the only tracked member of this family.
.env
.env.*
!.env.example

# Legacy flat-file data, retained only as an optional one-time migration input.
# Postgres is the runtime system of record. seed.json is tracked demo data and is
# used only when SEED_DEMO_DATA is explicitly enabled for a new empty instance.
data/

node_modules/
backups/
.DS_Store

# Playwright output
e2e-report/
e2e-results/
