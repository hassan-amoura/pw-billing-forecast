# Every variable this app reads. Copy to .env for local work; on a hosted
# deployment set these as platform secrets instead — .env and every .env.*
# file except this one are gitignored and never deployed.
#
# A missing required variable stops the server on boot with a message naming
# it. Optional defaults are documented beside the variables below.
#
# List variables (PW_TENANT_LOCK, INVOICE_STATUS_CODES, EXPENSE_STATUS_CODES,
# MODULE_CUSTOM_FIELD_LABELS, ARCHIVED_PROJECT_STATUSES) are comma-separated;
# whitespace around each item is trimmed, so "A, B" and "A,B" are identical.
#
# SJB production values (Render), secrets omitted:
#   NODE_ENV=production
#   ALLOW_WRITES=true
#   AUTH_MODE=basic
#   DATABASE_SSL_MODE=require
#   DEFAULT_STAGE_SORT=stageName
#   EXPENSE_STATUS_CODES=Approved
#   INVOICE_STATUS_CODES=Finance Approved
#   MODULE_CUSTOM_FIELD_LABELS=Stage No,Risk Status,Des / Del
#   PW_APP_BASE_URL=https://sjb.projectworksapp.com/
#   PW_BASE_URL=https://api.projectworksapp.com
#   PW_REQUEST_TIMEOUT_MS=30000
#   PW_TENANT_LOCK=SJB MEL,SJB SYD
#   SEED_DEMO_DATA=false
#   plus PW_USERNAME, PW_PASSWORD, DATABASE_URL, BASIC_AUTH_USER,
#   BASIC_AUTH_PASSWORD, INSTANCE_ID

# ---- Browser access gate (HTTP Basic) --------------------------------------
# REQUIRED. Every user-facing route, including the static page, sits behind
# HTTP Basic auth. `/healthz` is the sole non-sensitive exception. This is what
# stops a public deployment URL from handing anyone a live, write-enabled view
# of the tenant. The server refuses to start without both.
# Use a long random password — this is the only thing in front of the API token.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Escape hatch for local development ONLY: set to exactly "true" to run with no
# gate at all. Logs a prominent warning on every boot. Never set this on a
# hosted or public deployment.
# AUTH_DISABLED=true

# ---- Projectworks Open API connection ----------------------------------
# REQUIRED. The server refuses to start without a base URL.
# Point this at the STAGE tenant for all demo work. Only switch to
# production as part of a deliberate go-live step.
#
# e.g. PW_BASE_URL=https://api.<environment>.projectworksapp.com
PW_BASE_URL=

# REQUIRED. Timeout for every Projectworks request, including the tenant check.
# A bounded timeout prevents a failed upstream from leaving the hosted app blank.
PW_REQUEST_TIMEOUT_MS=30000

# ---- Tenant lock -----------------------------------------------------------
# REQUIRED. The expected tenant, as its office name in Projectworks
# (Settings -> Offices). On boot the server reads the office name back from
# GET /api/v1/Projects and refuses to start unless it matches this value.
#
# Why this exists: the API host above is identical for every tenant, production
# included — the tenant is decided solely by the credential. Without this lock
# a wrong credential runs silently, with writes enabled, against whichever
# tenant it happens to belong to. The lock makes re-pointing this deployment at
# a new sandbox a deliberate act: you must change this value too, and the
# server tells you the expected and actual tenant when they disagree.
#
# The Projectworks default office name ("My Organisation") is rejected — it
# identifies nothing, since every unrenamed tenant returns it. Rename the
# office in each demo sandbox to something unique, then set that name here.
# For a tenant with multiple organisations/offices, list every allowed exact
# name, comma-separated. Startup rejects any project office outside this list;
# it does not require an organisation with no returned projects to appear.
# SJB's projects sit in BOTH "SJB SYD" and "SJB MEL", so the lock must name
# both — "SJB SYD" alone refuses to start (unexpected office "SJB MEL").
# `npm run probe` reports which offices carry projects.
#
# e.g. PW_TENANT_LOCK=SJB Demo Sandbox
# e.g. PW_TENANT_LOCK=SJB MEL,SJB SYD
PW_TENANT_LOCK=

# ---- Projectworks API authentication ---------------------------------------
# The Open API swagger does not document its auth scheme, so both common
# shapes are supported. Set AUTH_MODE to whichever matches how you already
# call the API, and fill in only that section. REQUIRED, no default.

# Option A: HTTP Basic auth (API key as username, secret as password).
# Both are required when AUTH_MODE=basic.
# AUTH_MODE=basic
# PW_USERNAME=
# PW_PASSWORD=

# Option B: a single auth header (e.g. an API key header or bearer token).
# Both are required when AUTH_MODE=header — the header name has no default.
# AUTH_MODE=header
# PW_AUTH_HEADER_NAME=Authorization
# PW_AUTH_HEADER_VALUE=Bearer <token>
AUTH_MODE=

# ---- Write guard ---------------------------------------------------------
# Forecast writes (POST /Forecasts/Set) are DISABLED unless this is
# exactly "true". Anything else, including unset, means read-only. Leave
# false while pointing at any tenant you would not want to modify. The UI
# shows cells as read-only when writes are off.
ALLOW_WRITES=false

# ---- App-side Postgres store --------------------------------------------
# Postgres holds supplier lines, consultant-fee planning numbers and the audit
# trail. None is written to Projectworks. All three values below are required;
# the server validates them and refuses to boot if Postgres cannot be reached.
DATABASE_URL=
# Use "require" with a Render Postgres internal URL: Render's internal TLS uses
# self-signed certificates and does not support verify-full. Use "verify-full"
# with providers that supply a trusted certificate, or "disable" only for a
# trusted local connection.
DATABASE_SSL_MODE=require
# Stable deployment/tenant identifier used to scope every runtime query.
INSTANCE_ID=

# Optional positive integer. Unset means unlimited audit history. When set,
# entries over the limit are removed at boot; appending an entry never truncates.
# AUDIT_RETENTION_LIMIT=5000

# seed.json contains demo suppliers pinned to a demo moduleID. Set to exactly
# "true" to seed a brand-new, empty app-side dataset for INSTANCE_ID. Off by
# default so demo data can never appear in a customer deployment.
SEED_DEMO_DATA=false

# ---- Invoice status filter -----------------------------------------------
# REQUIRED. Comma-separated invoice statuses that count towards Gross Fees to
# Date, matched against each invoice's StatusCode text (case- and
# space-insensitive) or a numeric StatusID. The server refuses to start when
# this is empty because an unfiltered total would include drafts and
# unapproved invoices. The grid response reports meta.invoiceStatusesSeen.
# e.g. INVOICE_STATUS_CODES=Finance Approved
INVOICE_STATUS_CODES=

# REQUIRED. Comma-separated expense-claim statuses that count as approved
# consultant actuals. Consultant Fees to Date sums amountWithoutTax through
# today, excludes planned claims, and refuses to start when this is empty.
#
# Projectworks expense claims carry ONLY a numeric ExpenseClaimStatusID and
# the Open API has no endpoint that names those IDs, so each value is either:
#   - a numeric ID, used as-is (e.g. 4), or
#   - a name the app knows: "Approved" → ID 4. (Evidence: all 13,297 of SJB's
#     live expense claims carried ID 4, the approved filter it ran before.)
# Any other name can match only if claims ever carry a status-name field; if
# they do not, the grid shows a warning naming the value and the IDs seen.
# The boot log prints how each value resolved.
# e.g. EXPENSE_STATUS_CODES=Approved
# e.g. EXPENSE_STATUS_CODES=4
EXPENSE_STATUS_CODES=

# ---- Archived projects ---------------------------------------------------
# Optional. Project workflow statuses (ProjectStatusName) that mean archived.
# Default: Archived. A project is archived when IsActive=false OR its status
# is in this list — SJB keeps IsActive=true on every project and archives via
# the "Archived" status. Archived projects are dropped server-side unless the
# user ticks "Show archived projects".
# ARCHIVED_PROJECT_STATUSES=Archived

# ---- Module custom fields and default sort -------------------------------
# REQUIRED. Exactly three module (budget line) custom-field labels, in this
# order: stage number, risk status, third column. Matched by label against
# each module's CustomFields entries (case- and space-insensitive), never by a
# hardcoded field ID; the labels also become the column headers. They are
# shown read-only on Gross fees, Consultant fees and Net position. A module
# with no value shows a blank cell; a label the tenant does not define stays
# blank and produces a visible warning rather than crashing the app.
MODULE_CUSTOM_FIELD_LABELS=Stage No,Risk Status,Des / Del

# Optional override. Leave EMPTY for SJB. The app looks for an entity type
# named Module in GET /CustomFields/EntityTypes; SJB has none (module fields
# live under "Project Budget", ID 4) and does not need one, because its
# module values carry their Label. Setting this enables an ordinal (position)
# fallback that can put one field's value under another's column.
MODULE_CUSTOM_FIELD_ENTITY_TYPE_ID=

# REQUIRED. Project is always the primary default sort. Choose whether the
# secondary sort uses the Stage Name or Stage Number custom field.
DEFAULT_STAGE_SORT=stageName

# ---- Projectworks web app (deep links) -------------------------------------
# Optional. Tenant web app base URL, e.g. https://<tenant>.projectworksapp.com
# (a trailing slash is fine).
# Its subdomain is checked against the resolved tenant on boot: a mismatch logs
# a loud warning, because it means every deep link in the grid opens a
# different tenant than the numbers on screen.
# Used to build links from grid cells into Projectworks:
#   Project name → /Project/Overview/{projectID}
#   Stage name   → /Project/Budgets/{projectID}
#   Fee cell     → /Project/Forecasting/{projectID}
# Leave empty to render plain text instead of links.
PW_APP_BASE_URL=

# ---- Server --------------------------------------------------------------
# NODE_ENV=production adds a Strict-Transport-Security header. Render sets it.
# NODE_ENV=production

# Optional. Defaults to 3000. Hosted platforms usually inject this themselves;
# leave it unset there. The server always binds 0.0.0.0.
# PORT=3000
